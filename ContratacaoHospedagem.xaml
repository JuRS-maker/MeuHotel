<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuHotel.Wiews.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#141A29">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="10">
        <Label 
            Text="Cálculo da Diária"
            FontFamily="ElmsSansRegular"
            FontSize="40"
            TextColor="White"
            HorizontalOptions="Center"
            Margin="0, 0, 0, 5"/>

        <BoxView 
            HeightRequest="2" 
            WidthRequest="200" 
            Color= "#E6C068"
            HorizontalOptions="Center" 
            Margin="0, 0, 0, 25"/>
        
        <Frame Padding="10" 
               BorderColor="#2E4F73" 
               BackgroundColor="#1D3557">
            
            <VerticalStackLayout Spacing="10">
                <Grid RowDefinitions="Auto, Auto"
                         ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos"
                           TextColor="White"
                           FontFamily="ElmsSansRegular"/>

                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"
                           TextColor="White" 
                           FontFamily="ElmsSansRegular"/>


                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="#E6C068"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças"
                           TextColor="White"
                           FontFamily="ElmsSansRegular"/>
                    
                    <Label Grid.Row="1" Grid.Column="1"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_criancas}"
                            TextColor="White"
                            FontFamily="ElmsSansRegular"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                            x:Name="stp_criancas"
                            Minimum="0"
                            Maximum="10"
                            Increment="1" 
                            BackgroundColor="#E6C068"/>

                </Grid>

                <Label Text="Escolha sua Suíte" 
                       TextColor="#E6C068" 
                       FontFamily="ElmsSansRegular"
                       TextTransform="Uppercase"
                       FontSize="Medium"/>

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação:"
                        HorizontalTextAlignment="Center"
                        TitleColor="White"
                        ItemDisplayBinding="{Binding Descricao}"
                        TextColor="White"
                        FontFamily="ElmsSansRegular"/>

                <Frame Padding="10"
                       Margin="10"
                       BackgroundColor="#1D3557">
                   
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Período da Estadia" 
                               TextColor="#E6C068"
                               TextTransform="Uppercase"
                               FontSize="Medium"
                               FontFamily="ElmsSansRegular"/>
                        
                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Check-in:" TextColor="White" FontFamily="ElmsSansRegular"/>
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy"
                                        TextColor="White"
                                        FontFamily="ElmsSansRegular"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                            <Label Text="Check-out:" TextColor="White" FontFamily="ElmsSansRegular"/>
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" 
                                        TextColor="White"
                                        FontFamily="ElmsSansRegular"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar" Clicked="Button_Clicked" 
                        BackgroundColor="#E6C068"
                        TextColor="Black"/>

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>