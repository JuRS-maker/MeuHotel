<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeuHotel.Wiews.SobreHotel"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#141A29">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="30" Spacing="0">

        <!-- Título Principal -->
        <Label 
            Text="Sobre"
            HorizontalOptions="Center"
            FontFamily="ElmsSansRegular"
            TextColor="White"
            FontSize="48"
            Margin="0, 0, 0, 5"/>

        <!-- Detalhe Visual: Linha sutil abaixo do título -->
        <BoxView 
            HeightRequest="2" 
            WidthRequest="60" 
            Color="#E6C068" 
            HorizontalOptions="Center" 
            Margin="0, 0, 0, 25"/>

        <!-- Nome do Hotel -->
        <Label
            Text="Hotel Luz de Verão"
            FontFamily="ElmsSansRegular"
            TextColor="#E6C068" 
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0, 0, 0, 20"/>

        <!-- Card Decorativo para a Frase de Impacto -->
        <Frame BackgroundColor="#1D3557"
               CornerRadius="12"
               Padding="20"
               HasShadow="False"
               BorderColor="#2E4F73">

            <Label
                Text="O melhor lugar onde você e sua família podem relaxar e curtir o paraíso tropical."
                FontFamily="ElmsSansRegular"
                TextColor="#D9D9D9"
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineHeight="1.4"/>
          
        </Frame>

        <Frame BackgroundColor="#1D3557"
                CornerRadius="12"
                Padding="20"
                HasShadow="False"
                BorderColor="#2E4F73">

            <Label
                Text="Fundado em 2015, inovou os conceitos de hoteis à beira mar com as fantásticas estrelas das Noites de Verão."
                FontFamily="ElmsSansRegular"
                TextColor="#D9D9D9"
                FontSize="16"
                HorizontalTextAlignment="Center"
                LineHeight="1.4"/>

        </Frame>

        <Label
            Text="Desenvolvido por @JURIS TECHNOLOGY
             By Júlia Ribeiro de Souza"
            FontFamily="ElmsSansRegular"
            TextColor="#D9D9D9"
            FontSize="14"
            HorizontalTextAlignment="Center"
            LineHeight="1.4"
            Margin="0, 10, 0, 10"/>

        <DatePicker Date="2026-05-16"
                    TextColor="White" 
                    HorizontalOptions="Center"
                    Margin="0, 0, 0, 10"
                    FontFamily="ElmsSansRegular"/>

    </VerticalStackLayout>
</ContentPage>